{
  "name": "@heurica/tap",
  "version": "0.1.0",
  "description": "Text Action Protocol: tool use for any model, in plain text. Parser, observation formatter, tool catalog and a small agent loop.",
  "keywords": [
    "llm",
    "agents",
    "tool-use",
    "tool-calling",
    "protocol",
    "parser",
    "ai",
    "function-calling",
    "json-repair",
    "text-protocol"
  ],
  "license": "MIT",
  "author": "Heurica <hello@heurica.dev>",
  "homepage": "https://heurica.dev/tap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heurica-labs/tap.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/heurica-labs/tap/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "gen:aliases": "node scripts/gen-aliases.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
